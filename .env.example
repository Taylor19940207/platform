# 複製為 .env.local 後依需要調整。所有服務連線一律由此注入，程式內不得寫死。

# ── PostgreSQL ──────────────────────────────────────
# PSQL_MODE=docker：透過 `docker exec` 進 compose 的 db 容器執行（Mac 預設，免裝 psql）
# PSQL_MODE=local ：使用本機 psql 二進位（需自行安裝，如 brew install libpq）
PSQL_MODE=docker
DB_CONTAINER=cbfc-db
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=dev
DB_PASSWORD=dev
DB_NAME=cbfc_dev

# ── 應用 ────────────────────────────────────────────
PORT=8080
POLL_MS=1500
# 物件儲存目錄（開發用檔案系統實作；正式環境換 S3/MinIO 介面）
OBJECT_STORE_DIR=var/objects
# session 簽章密鑰；留空則自動產生於 var/session.secret
SESSION_SECRET=

# ── Redis／MinIO（compose 已啟動；應用接線屬後續里程碑） ──
REDIS_URL=redis://127.0.0.1:6379
MINIO_ENDPOINT=http://127.0.0.1:9000
